
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Desafio da Live</title>

<style>
body {
  margin: 0;
  padding: 20px 12px;
  background: linear-gradient(160deg, #18002e, #7200a8);
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  color: #ffd700;
  font-size: 30px;
  margin-top: 25px;
}

p {
  font-size: 18px;
}

#numeros {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  max-width: 500px;
  margin: 25px auto;
}

.numero {
  background: white;
  color: #65009b;
  border: 2px solid gold;
  border-radius: 10px;
  padding: 15px 2px;
  font-size: 19px;
  font-weight: bold;
}

.numero:disabled {
  background: #444;
  color: white;
  border-color: #777;
}

#mensagem {
  color: gold;
  font-size: 23px;
  font-weight: bold;
  min-height: 65px;
  margin-top: 20px;
}

#reiniciar {
  background: gold;
  color: #35004d;
  padding: 15px 30px;
  border: none;
  border-radius: 12px;
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 30px;
}
</style>
</head>

<body>

<h1>🎁 DESAFIO DA LIVE 🎁</h1>
<p>Escolha um número de 1 até 100!</p>
<p>Será que você consegue? 😍</p>

<div id="numeros"></div>

<div id="mensagem"></div>

<button id="reiniciar" onclick="reiniciar()">
🔄 RECOMEÇAR
</button>

<script>
const area = document.getElementById("numeros");
const mensagem = document.getElementById("mensagem");

function criarJogo() {
  area.innerHTML = "";

  for (let i = 1; i <= 100; i++) {
    const botao = document.createElement("button");

    botao.className = "numero";
    botao.textContent = i;

    botao.addEventListener("click", function() {
      botao.disabled = true;
      botao.textContent = "❌";
      mensagem.textContent = "😅 NÃO FOI DESSA VEZ! TENTE OUTRO!";
    });

    area.appendChild(botao);
  }
}

function reiniciar() {
  mensagem.textContent = "";
  criarJogo();
}

criarJogo();
</script>

</body>
</html>
